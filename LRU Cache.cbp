<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="LRU Cache" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="LRU Cache Lista">
				<Option output="lib/LruCacheList" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="obj/Debug/" />
				<Option type="2" />
				<Option compiler="gcc" />
				<Option createDefFile="1" />
				<Compiler>
					<Add option="-pedantic" />
					<Add option="-Wextra" />
					<Add option="-Wall" />
					<Add option="-ansi" />
					<Add option="-ggdb" />
					<Add option="-g" />
					<Add directory="includes" />
				</Compiler>
			</Target>
			<Target title="Tweener Cache Indice">
				<Option output="bin/Release/LRU Cache" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-DCACHE_INDICE=1" />
					<Add directory="includes" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
			<Target title="Test LRU Cache P1">
				<Option output="LRU Cache" prefix_auto="1" extension_auto="1" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-ggdb" />
					<Add option="-g" />
					<Add directory="includes" />
				</Compiler>
				<Linker>
					<Add option="-lLruCacheList" />
					<Add directory="lib" />
				</Linker>
			</Target>
			<Target title="Test LRU Cache P2">
				<Option output="LRU Cache" prefix_auto="1" extension_auto="1" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add directory="includes" />
				</Compiler>
				<Linker>
					<Add option="-lLruCacheIndex" />
					<Add directory="lib" />
				</Linker>
			</Target>
			<Target title="LRU Cache Indice">
				<Option output="lib/LruCacheIndex" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="obj/Debug/" />
				<Option type="2" />
				<Option compiler="gcc" />
				<Option createDefFile="1" />
				<Compiler>
					<Add option="-pedantic" />
					<Add option="-Wextra" />
					<Add option="-Wall" />
					<Add option="-ansi" />
					<Add option="-g" />
					<Add directory="includes" />
				</Compiler>
			</Target>
			<Target title="Tweener Cache Lista">
				<Option output="bin/Release/LRU Cache" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-DCACHE_LISTA=1" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
		</Compiler>
		<Unit filename="Test/test_lru_cache_parte1.c">
			<Option compilerVar="CC" />
			<Option target="Test LRU Cache P1" />
		</Unit>
		<Unit filename="Test/test_lru_cache_parte2.c">
